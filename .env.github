# GitHub Settings > Environments > production > Environment secrets.
GCP_COMPUTE_ENGINE_ZONE=europe-west1-b
GCP_COMPUTE_ENGINE_NAME=REPLACE_WITH_VM_NAME
GCP_COMPUTE_ENGINE_PROJECT=REPLACE_WITH_PROJECT_ID
GCP_COMPUTE_ENGINE_EXTERNAL_IP=
GCP_WIF_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID
GCP_DEPLOY_SERVICE_ACCOUNT=ACCOUNT@PROJECT_ID.iam.gserviceaccount.com
GAR_LOCATION=europe-west1

# ONE multiline secret: paste the runtime file CONTENTS, not its filename.
# Use redis://redis:6379/0 for bundled Redis, and a reachable PostgreSQL host.
# Full setup/WIF instructions: deploy/compute/README.md
KWONREC_ENV=PASTE_MULTILINE_RUNTIME_CONTENTS_IN_GITHUB
