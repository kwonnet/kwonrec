# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
KWONREC_API_KEY=replace-with-a-random-key-of-at-least-32-characters
KWONREC_REDIS_URL=redis://localhost:6379/0
KWONREC_REDIS_CLUSTER=false
# This must be kwonserver's PostgreSQL database, not ClickHouse.
# From Docker Desktop use host.docker.internal for host services.
KWONREC_DATABASE_URL=postgresql://kwonnet:password@localhost:5432/kwonnet?schema=public
KWONREC_NAMESPACE=kwonrec:v2
KWONREC_CATALOG_DAYS=30
KWONREC_HISTORY_DAYS=30
KWONREC_CANDIDATE_LIMIT=1000
KWONREC_INDEX_LIMIT=5000
KWONREC_AUTHOR_CAP=3
KWONREC_EXPLORATION_RATE=0.1
KWONREC_POLL_SECONDS=0.25
KWONREC_WORKER_BATCH=100
# Local development only; leave false in deployed environments.
KWONREC_ALLOW_UNAUTHENTICATED=false
